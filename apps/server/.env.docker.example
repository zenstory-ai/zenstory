# zenstory production Docker environment template
# Copy to apps/server/.env.docker, fill every blank required value, and export it before compose startup.

ENVIRONMENT=production

# Generate URL-safe database/Redis passwords, for example: openssl rand -hex 32
POSTGRES_OWNER_USER=
POSTGRES_OWNER_PASSWORD=
POSTGRES_DB=
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=
REDIS_PASSWORD=

# At least 32 random characters: openssl rand -hex 32
JWT_SECRET_KEY=

# Required for the writing agent (the model is fixed in code to deepseek-flash).
DEEPSEEK_API_KEY=

CORS_ORIGINS=https://REQUIRED_public_web_origin
FRONTEND_URL=https://REQUIRED_public_web_origin
INSPIRATIONS_ENABLED=false

# Zpay checkout (optional; disabled until explicitly enabled)
# ZPAY_NOTIFY_URL must be on the API host (not FRONTEND_URL) with exactly this path;
# otherwise checkout stays disabled and startup logs an ERROR.
ZPAY_ENABLED=false
ZPAY_PID=
ZPAY_KEY=
ZPAY_NOTIFY_URL=https://REQUIRED_public_api_origin/api/v1/payments/zpay/notify
ZPAY_RETURN_URL=https://REQUIRED_public_web_origin/dashboard/billing/payment-return
ZPAY_CID=
