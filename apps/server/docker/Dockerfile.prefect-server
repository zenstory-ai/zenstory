# Prefect Server Dockerfile
# 用于 Railway 部署

FROM python:3.11-slim

WORKDIR /app

# 安装 Prefect 和 PostgreSQL 驱动
# Keep Prefect and FastAPI aligned with requirements.txt. FastAPI 0.141.x changes
# routing internals in a way that breaks PrefectRouter at request time, despite
# satisfying Prefect's declared `fastapi<1.0.0` range. 0.123.7 is covered by the
# compatibility contract in CI.
RUN pip install --no-cache-dir \
    prefect==3.6.28 \
    asyncpg \
    psycopg2-binary \
    importlib-metadata \
    "fastapi==0.123.7"

# 暴露端口 (Railway 会自动分配 PORT)
EXPOSE 4200

# 启动脚本
COPY apps/server/docker/start-prefect-server.sh /start.sh
RUN chmod +x /start.sh

CMD ["/start.sh"]
