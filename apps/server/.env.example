# ============================================
# Quick Start — writing agent uses DeepSeek only
# ============================================

# Required for the writing agent.
# The model is fixed in code to deepseek-flash.
DEEPSEEK_API_KEY=your-deepseek-api-key

# ============================================
# Optional settings with sensible defaults
# ============================================

# --- Optional product modules ---
# Inspiration library is disabled unless explicitly enabled.
INSPIRATIONS_ENABLED=false

# --- Writing Agent runtime (optional) ---
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AGENT_OPENAI_AGENTS_MAX_OUTPUT_TOKENS=64000
# AGENT_ROUTER_STRATEGY=llm
# AGENT_ENABLE_GRAPH_AUTO_REVIEW=true

# --- Material library decomposition stages (optional) ---
# Defaults turn off per-chapter plot extraction and everything built on it
# (stories, storylines, relationships). Chapter summaries and character
# extraction still send each chapter's full text, so this is 2 full-text calls
# per chapter instead of 3 (plus synopsis and golden finger + worldview calls).
# Dependencies are enforced at runtime (a stage whose inputs are off is skipped):
#   synopsis needs summaries; stories (STORY_AGGREGATION) need summaries + plots;
#   storylines (STORYLINE_GENERATION) need stories; relationships need plots + characters.
# MATERIAL_ENABLE_CHAPTER_SUMMARIES=true
# MATERIAL_ENABLE_PLOT_EXTRACTION=false
# MATERIAL_ENABLE_CHARACTER_EXTRACTION=true
# MATERIAL_ENABLE_META_EXTRACTION=true
# MATERIAL_ENABLE_NOVEL_SYNOPSIS=true
# MATERIAL_ENABLE_STORY_AGGREGATION=false
# MATERIAL_ENABLE_STORYLINE_GENERATION=false
# MATERIAL_ENABLE_RELATIONSHIP_EXTRACTION=false
# MATERIAL_ENABLE_NEO4J_STORAGE=false
# Deprecated (unset by default): MATERIAL_ENABLE_ENTITY_EXTRACTION=true|false,
# when set, is used for CHARACTER_EXTRACTION / META_EXTRACTION only where
# those two flags are not set explicitly.
# Cost guards (read by the API upload pre-check and the worker; keep equal):
# MATERIAL_MAX_CHAPTERS_PER_NOVEL=3000
# MATERIAL_LLM_REQUEST_TIMEOUT_SECONDS=180
# MATERIAL_LLM_SDK_MAX_RETRIES=2

# --- Database (optional) ---
# Defaults to SQLite for local dev; set for PostgreSQL in production
# DATABASE_URL=postgresql://user:password@host:port/database

# --- Auth (optional) ---
# JWT_SECRET_KEY is auto-generated in development.
# Must be set explicitly (min 32 chars) in production/staging.
# JWT_SECRET_KEY=
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (optional) ---
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- General (optional) ---
# LOG_LEVEL=INFO
# APP_NAME=zenstory
# APP_VERSION=1.0.0
# CHROMA_PERSIST_DIR=./chroma_data

# ============================================
# Advanced / Production-only
# ============================================

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# FRONTEND_URL=https://zenstory.ai

# Zhipu Embeddings (for vector search)
# ZHIPU_EMBEDDINGS_API_KEY=
# ZHIPU_EMBEDDINGS_MODEL=embedding-3

# Tencent ASR (voice input)
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=

# Rate Limiting
# AUTH_RATE_LIMIT_ENABLED=true
# RATE_LIMIT_BACKEND=auto

# Redemption Codes
# REDEMPTION_CODE_HMAC_SECRET=

# Zpay checkout (disabled by default; never commit real credentials)
# ZPAY_ENABLED=false
# ZPAY_PID=
# ZPAY_KEY=
# ZPAY_NOTIFY_URL=https://api.example.com/api/v1/payments/zpay/notify
# ZPAY_RETURN_URL=https://app.example.com/dashboard/billing/payment-return
# ZPAY_CID=
