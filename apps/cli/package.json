{
  "name": "zenstory",
  "version": "0.2.0",
  "description": "Command-line client and Agent Skill for ZenStory novel projects (public Agent API).",
  "type": "module",
  "bin": {
    "zenstory": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "zenstory",
    "novel",
