    "codex",
    "openclaw"
  ],
  "homepage": "https://zenstory.ai",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zenstory-ai/zenstory.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
